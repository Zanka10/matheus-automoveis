# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/matheus_automoveis?schema=public"

# Auth.js — gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"
AUTH_TRUST_HOST=true

# URL pública do site (usada em links de compartilhamento)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary (opcional). Sem estas variáveis, os uploads são salvos em /public/uploads (apenas desenvolvimento).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="matheus-automoveis"

# Administrador inicial criado pelo seed
SEED_ADMIN_EMAIL="admin@matheusautomoveis.com.br"
SEED_ADMIN_PASSWORD="Admin@12345"
